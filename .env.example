# MySQL (日志数据源，必填)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=sspanel

# 管理员登录（必填，明文密码做 SHA256 后填入）
ADMIN_PASSWORD_SHA256=replace_with_sha256_hex

# 管理员会话签名盐（建议修改为随机字符串）
ADMIN_SESSION_SECRET=replace_with_random_secret

# SQLite (仅用于保存筛选条件和查询结果归档)
SQLITE_PATH=data/query-archive.sqlite
